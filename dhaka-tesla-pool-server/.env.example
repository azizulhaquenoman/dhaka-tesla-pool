DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/dhaka_tesla_pool?schema=public
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_another_long_random_string
PORT=4000
NODE_ENV=development

# OTP delivery. Keep console for local development; use smtp/greenapi when configured.
OTP_EMAIL_PROVIDER=console
OTP_WHATSAPP_PROVIDER=console
OTP_LOG_VALUES=true

# SMTP email delivery (required when OTP_EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=no-reply@example.com

# Green API WhatsApp delivery (required when OTP_WHATSAPP_PROVIDER=greenapi)
GREENAPI_BASE_URL=https://api.greenapi.com
GREENAPI_INSTANCE_ID=your_greenapi_instance_id
GREENAPI_API_TOKEN=your_greenapi_api_token
GREENAPI_COUNTRY_CODE=88
